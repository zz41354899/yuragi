{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": { "@yuragi/rig": ["../../packages/rig/src/index.ts"], "@yuragi/rig/vue": ["../../packages/rig/src/vue.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
