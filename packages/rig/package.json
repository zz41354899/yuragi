{
  "name": "@yuragi/rig",
  "version": "0.2.0",
  "license": "MIT",
  "description": "A TypeScript 2D illustration rig, with Vue and React adapters.",
  "type": "module",
  "files": [
    "dist",
    "src",
    "assets",
    "README.md",
    "LICENSE",
    "LICENSE-SCOPE.md",
    "studio"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./assets/*": "./assets/*",
    "./mirea": {
      "types": "./dist/mirea.d.ts",
      "import": "./dist/mirea.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "playwright": "^1.50.0",
    "react": "^18.3.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "tsx": "^4.20.0"
  },
  "bin": {
    "yuragi": "./dist/studio/cli.js"
  },
  "dependencies": {
    "image-size": "^2.0.4"
  }
}
