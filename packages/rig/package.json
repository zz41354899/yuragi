{
  "name": "@yuragi/rig",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "description": "A TypeScript 2D illustration rig, with Vue and React adapters.",
  "type": "module",
  "files": ["dist", "src", "assets", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./vue": { "types": "./dist/vue.d.ts", "import": "./dist/vue.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./assets/*": "./assets/*"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": { "vue": "^3.5.0", "react": "^18.3.0 || ^19.0.0" },
  "peerDependenciesMeta": { "vue": { "optional": true }, "react": { "optional": true } },
  "devDependencies": { "@types/react": "^19.2.0", "tsx": "^4.20.0" }
}
